<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_title" android:textColor="#F4F8FC" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_empty" android:textColor="#8FB3D9" android:textSize="12sp" android:layout_marginBottom="6dp" />
    <TextView android:id="@+id/w_line1" style="@style/WidgetLine" />
    <TextView android:id="@+id/w_line2" style="@style/WidgetLine" />
    <TextView android:id="@+id/w_line3" style="@style/WidgetLine" />
    <TextView android:id="@+id/w_line4" style="@style/WidgetLine" />
    <TextView android:id="@+id/w_line5" style="@style/WidgetLine" />
</LinearLayout>
