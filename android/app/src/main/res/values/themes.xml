<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hubtech" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/hubtech_bg</item>
        <item name="android:statusBarColor">@color/hubtech_bg</item>
        <item name="android:navigationBarColor">@color/hubtech_bg</item>
        <item name="colorPrimary">@color/hubtech_accent</item>
        <item name="colorAccent">@color/hubtech_accent</item>
    </style>
    <style name="WidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#DCE7F3</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
