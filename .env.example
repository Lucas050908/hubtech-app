# HUBTECH — kopier til .env og ret efter behov. Alle værdier er valgfrie.
# Rigtige hemmeligheder hører aldrig hjemme i denne fil eller i git.

# Netværk. 127.0.0.1 = kun denne computer (anbefalet). 0.0.0.0 = hele netværket (brug HTTPS foran!)
HUBTECH_HOST=127.0.0.1
HUBTECH_PORT=8090

# Hvor databasen gemmes (standard: ~/.hubtech)
# HUBTECH_DATA_DIR=~/.hubtech

# Tilmelding: first = kun den første konto (ejeren) kan oprette sig selv, ejeren opretter resten
#             open  = alle der kan nå serveren kan oprette en konto
#             closed = ingen nye konti
HUBTECH_SIGNUP=first

# Hvor længe en session holder (dage, forlænges ved brug)
HUBTECH_SESSION_DAYS=14

# Sæt til true når HUBTECH kører bag HTTPS (reverse proxy), så cookies kun sendes krypteret
HUBTECH_SECURE_COOKIES=false

# ── Cursor-integration ──
# Ekstra projektmapper, adskilt med : på macOS/Linux og ; på Windows
# HUBTECH_PROJECT_ROOTS=~/Projects:~/code
# Kun hvis Cursor ligger et usædvanligt sted:
# HUBTECH_CURSOR_USER_DIR=~/.config/Cursor
# HUBTECH_CURSOR_CLI=/usr/local/bin/cursor

# ── Forbindelser ──
HUBTECH_BYTEFORGE_URL=http://127.0.0.1:8080
# Start the bundled ByteForge server automatically (true/false)
HUBTECH_BYTEFORGE_AUTOSTART=true
# Hvor de oprindelige HUBTECH-moduler (m.html, gamehob.html, kalender.html …) ligger
# HUBTECH_SITE_URL=https://dit-hubtech-site.dk
